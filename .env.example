# Copy to .env and adjust. Every value is optional; the defaults are shown.

# Session signing key. Set a long random value before exposing the app to anyone else,
# e.g. python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-change-in-production

# Database and uploads
# DATABASE_URI=sqlite:////absolute/path/to/inventory.db   # default: instance/inventory.db
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# First-run admin account (only used when the user does not exist yet)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@example.com

# Sessions. Set SESSION_COOKIE_SECURE=true when the app is served over HTTPS.
SESSION_LIFETIME_HOURS=8
SESSION_COOKIE_SECURE=false

# Demo mode restricts destructive operations
DEMO_MODE=false
